# ==============================================================================
# FRONTEND / BACKEND CORE
# ==============================================================================
APP_BASE_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:5001
SERVER_PORT=5001
ALLOWED_ORIGINS=

# ==============================================================================
# CODE EXECUTION
# ==============================================================================
EXECUTION_PROVIDER=auto
ALLOW_LOCAL_EXECUTION_FALLBACK=true

# ==============================================================================
# RATE LIMITING
# ==============================================================================
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=180

# ==============================================================================
# AUTHENTICATION & FIREBASE (Optional)
# If Firebase keys are omitted, the app defaults to local auth automatically.
# ==============================================================================
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
AUTH_EXPOSE_RECOVERY_DEBUG=false

# ==============================================================================
# SMTP NOTIFICATIONS (Optional)
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Provider Examples:
# Gmail: HOST=smtp.gmail.com, PORT=465, PASS=<16_char_app_password>
# SendGrid: HOST=smtp.sendgrid.net, PORT=587, USER=apikey, PASS=<api_key>
